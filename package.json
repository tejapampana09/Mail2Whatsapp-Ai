{
  "name": "mail2whatsapp-ai",
  "version": "1.0.0",
  "description": "Connect your inbox to classify and summarize incoming emails instantly with Gemini AI and simulate WhatsApp routing.",
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"const major = Number(process.versions.node.split('.')[0]); if (major < 20) { console.error('ERROR: Mail2WhatsApp requires Node.js 20 LTS or higher.'); process.exit(1); }\"",
    "dev": "tsx watch src/app/server.ts",
    "build": "vite build",
    "start": "tsx src/app/server.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^5.3.1",
    "@google/genai": "latest",
    "better-sqlite3": "^11.1.2",
    "bullmq": "^6.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "google-auth-library": "^9.15.1",
    "googleapis": "^173.0.0",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.400.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tsx": "^4.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
