# Mail2WhatsApp AI System Environment Variables

# Node & Server Configuration
NODE_ENV=production
PORT=3000
DATABASE_PATH=mail2whatsapp.db
# Set TRUST_PROXY based on your topology ('1', 'loopback', 'true', or 'false')
TRUST_PROXY=false

# Dedicated Database Column Encryption (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=your_db_encryption_key_at_least_32_chars_long

# JWT Authentication Security
JWT_SECRET=your_jwt_signing_secret_minimum_16_chars

# LLM Provider Configuration
# Choose 'google', 'openrouter', or 'openai'
LLM_PROVIDER=google
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gemini-2.5-flash
# Optional alternative API keys
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Google OAuth 2.0 Credentials (Gmail API & Calendar)
# Create credentials in Google Cloud Console with Gmail & Calendar API enabled
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# WhatsApp Meta Cloud API Credentials
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# App Secret from Meta App Dashboard for X-Hub-Signature-256 HMAC verification
META_APP_SECRET=your_meta_app_secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=mail2whatsapp_secure_webhook_token_2026
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_DIGEST_TEMPLATE_NAME=
WHATSAPP_DIGEST_TEMPLATE_LANG=en
WHATSAPP_VOICE_ENABLED=false
TTS_PROVIDER=none

# Google Cloud Pub/Sub Webhook Security (Cryptographic OIDC JWT Verification)
PUBSUB_AUDIENCE=https://whatsapp2mail.duckdns.org/webhook/gmail
PUBSUB_SERVICE_ACCOUNT=your-service-account@your-gcp-project.iam.gserviceaccount.com

# WhatsApp Outbox Worker & Retry Tuning
WHATSAPP_MAX_RETRIES=6
WHATSAPP_BATCH_SIZE=10
WHATSAPP_POLL_INTERVAL_MS=5000
WHATSAPP_STALE_TIMEOUT_MS=180000

# Redis Queue Configuration (Optional, falls back to durable SQLite outbox)
REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=https://whatsapp2mail.duckdns.org,http://localhost:3000,http://localhost:5173
